# VITE_CODESPACE_NAME must be defined when running in GitHub Codespaces
# When running locally, leave this commented out or empty to use localhost
# VITE_CODESPACE_NAME=your-codespace-name

# Example for Codespaces:
# VITE_CODESPACE_NAME=redesigned-journey-q5pq7p5g6493pxqx

# For local development, create a .env.local file (not tracked in git)
# and leave VITE_CODESPACE_NAME undefined or empty
